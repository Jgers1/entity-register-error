public class EntityInit {
    public static final EntityType<MonsterEntity> MONSTER = Registry.register(Registries.ENTITY_TYPE,
            Identifier.of(Monster.MOD_ID, "monster"),
            EntityType.Builder.create(MonsterEntity::new, SpawnGroup.MONSTER)
                    .dimensions(1f, 2.5f).build());

    public static void registerModEntities() {
        Monster.LOGGER.info("Registering mod entities for " + Monster.MOD_ID);
    }
}
